# Local demo mode needs no credentials.
CAMPUS_TWIN_DATA_MODE=demo

# Local Databricks-connected mode:
# CAMPUS_TWIN_DATA_MODE=auto
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<local-development-token-only>
# DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# CAMPUS_TWIN_CATALOG=workspace
# CAMPUS_TWIN_SCHEMA=campus_twin
# DATABRICKS_GENIE_SPACE_ID=<optional-existing-space-id>
# CAMPUS_TWIN_GENIE_PARENT_PATH=/Workspace/Users/<your-email>  # needed for local Genie creation
