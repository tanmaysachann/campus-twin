# Local real Databricks mode. Do not commit a filled copy with a token.
CAMPUS_TWIN_DATA_MODE=databricks
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=<local-development-token-only>
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
CAMPUS_TWIN_CATALOG=workspace
CAMPUS_TWIN_SCHEMA=campus_twin

# Required only when creating a new Genie Space from local development.
CAMPUS_TWIN_GENIE_PARENT_PATH=/Workspace/Users/<your-email>

# Optional if you already created or linked the Genie Space.
# DATABRICKS_GENIE_SPACE_ID=<existing-space-id>
